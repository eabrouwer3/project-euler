# Database
DATABASE_URL=postgresql://euler:euler@localhost:5432/euler

# Auth.js — generate with: openssl rand -hex 32
AUTH_SECRET=

# Required when behind a reverse proxy
AUTH_TRUST_HOST=true

# GitHub OAuth App (create at github.com/settings/developers)
# Callback URL: http://localhost:5173/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL
ORIGIN=http://localhost:5173

# Code execution runner service
# Local (docker-compose): RUNNER_URL=http://localhost:3001
# Railway: RUNNER_URL=http://runner.railway.internal:3001
RUNNER_URL=

# --- Runner service only ---
# Solutions execute in a Railway Sandbox (a per-submission VM), not in the runner container,
# so the runner needs API credentials and refuses to start without them.
# Token: https://railway.com/account/tokens
RAILWAY_API_TOKEN=
# The environment sandboxes are created in; also scopes the toolchain checkpoint.
# Only needed locally — Railway injects this into every deployed service already, so the
# runner service needs nothing but the token above.
RAILWAY_ENVIRONMENT_ID=
# Optional. Sandboxes default to us-west2 regardless of account preference, so this should
# match wherever the services run to keep exec round-trips local.
SANDBOX_REGION=us-east4-eqdc4a
# Optional. Concurrent sandboxes; the plan's per-environment cap is the hard ceiling.
MAX_CONCURRENT_RUNS=16
